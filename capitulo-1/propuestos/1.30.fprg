<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
<attributes><attribute name="name" value="Propuesto 1.30"/><attribute name="authors" value="Javier Marcelo Flores Monrroy"/></attributes>
<function name="Main" type="None" variable=""><parameters/><body><declare name="A" type="Integer" array="False" size=""/><declare name="B" type="Integer" array="False" size=""/><declare name="SA" type="Integer" array="False" size=""/><declare name="C" type="Integer" array="False" size=""/><declare name="SB" type="Integer" array="False" size=""/><output expression="&quot;Primer número&quot;" newline="True"/><input variable="A"/><output expression="&quot;Segundo número&quot;" newline="True"/><input variable="B"/><assign variable="SA" expression="0"/><for variable="C" start="1" end="A - 1" direction="inc" step="1"><if expression="(A % C) == 0"><then><assign variable="SA" expression="SA + C"/></then><else></else></if></for><assign variable="SB" expression="0"/><for variable="C" start="1" end="B - 1" direction="inc" step="1"><if expression="(B % C) == 0"><then><assign variable="SB" expression="SB + C"/></then><else></else></if></for><if expression="SA == B and SB == A"><then><output expression="&quot;Son amigos&quot;" newline="True"/></then><else><output expression="&quot;No son amigos&quot;" newline="True"/></else></if></body></function>
</flowgorithm>
