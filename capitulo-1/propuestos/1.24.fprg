<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
<attributes><attribute name="name" value="Propuesto 1.24"/><attribute name="authors" value="Javier Marcelo Flores Monrroy"/></attributes>
<function name="Main" type="None" variable=""><parameters/><body><declare name="N" type="Integer" array="False" size=""/><declare name="D" type="Integer" array="False" size=""/><output expression="&quot;Número de varios dígitos&quot;" newline="True"/><input variable="N"/><while expression="N &gt; 0"><assign variable="D" expression="N % 10"/><if expression="(D % 2) == 0"><then><output expression="D" newline="True"/></then><else></else></if><assign variable="N" expression="N / 10"/></while></body></function>
</flowgorithm>
