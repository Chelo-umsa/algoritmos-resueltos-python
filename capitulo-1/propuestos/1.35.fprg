<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
<attributes><attribute name="name" value="Propuesto 1.35"/><attribute name="authors" value="Javier Marcelo Flores Monrroy"/></attributes>
<function name="Main" type="None" variable=""><parameters/><body><declare name="N" type="Integer" array="False" size=""/><declare name="A" type="Integer" array="False" size=""/><declare name="B" type="Integer" array="False" size=""/><declare name="S" type="Integer" array="False" size=""/><declare name="C" type="Integer" array="False" size=""/><declare name="F" type="Integer" array="False" size=""/><declare name="i" type="Integer" array="False" size=""/><declare name="T" type="Integer" array="False" size=""/><output expression="&quot;Cantidad de términos&quot;" newline="True"/><input variable="N"/><assign variable="A" expression="0"/><assign variable="B" expression="1"/><assign variable="S" expression="0"/><for variable="C" start="1" end="N" direction="inc" step="1"><assign variable="F" expression="1"/><for variable="i" start="1" end="A" direction="inc" step="1"><assign variable="F" expression="F * i"/></for><assign variable="S" expression="S + F"/><assign variable="T" expression="A + B"/><assign variable="A" expression="B"/><assign variable="B" expression="T"/></for><output expression="S" newline="True"/></body></function>
</flowgorithm>
