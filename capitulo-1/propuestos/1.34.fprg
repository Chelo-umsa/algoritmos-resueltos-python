<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
<attributes><attribute name="name" value="Propuesto 1.34"/><attribute name="authors" value="Javier Marcelo Flores Monrroy"/></attributes>
<function name="Main" type="None" variable=""><parameters/><body><declare name="B" type="Integer" array="False" size=""/><declare name="P" type="Integer" array="False" size=""/><declare name="R" type="Integer" array="False" size=""/><declare name="C" type="Integer" array="False" size=""/><declare name="S" type="Integer" array="False" size=""/><declare name="i" type="Integer" array="False" size=""/><output expression="&quot;Base&quot;" newline="True"/><input variable="B"/><output expression="&quot;Exponente&quot;" newline="True"/><input variable="P"/><assign variable="R" expression="1"/><assign variable="C" expression="0"/><while expression="C &lt; P"><assign variable="S" expression="0"/><assign variable="i" expression="0"/><while expression="i &lt; B"><assign variable="S" expression="S + R"/><assign variable="i" expression="i + 1"/></while><assign variable="R" expression="S"/><assign variable="C" expression="C + 1"/></while><output expression="R" newline="True"/></body></function>
</flowgorithm>
