<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
<attributes><attribute name="name" value="Propuesto 1.28"/><attribute name="authors" value="Javier Marcelo Flores Monrroy"/></attributes>
<function name="Main" type="None" variable=""><parameters/><body><declare name="N" type="Integer" array="False" size=""/><declare name="M" type="Integer" array="False" size=""/><declare name="C" type="Integer" array="False" size=""/><declare name="Q" type="Integer" array="False" size=""/><declare name="i" type="Integer" array="False" size=""/><declare name="T" type="Integer" array="False" size=""/><output expression="&quot;Número de varios dígitos&quot;" newline="True"/><input variable="N"/><assign variable="M" expression="0"/><for variable="C" start="9" end="2" direction="dec" step="1"><assign variable="Q" expression="0"/><for variable="i" start="1" end="C" direction="inc" step="1"><if expression="(C % i) == 0"><then><assign variable="Q" expression="Q + 1"/></then><else></else></if></for><if expression="Q == 2"><then><assign variable="T" expression="N"/><while expression="T &gt; 0"><if expression="(T % 10) == C"><then><assign variable="M" expression="(M * 10) + C"/></then><else></else></if><assign variable="T" expression="T / 10"/></while></then><else></else></if></for><output expression="M" newline="True"/></body></function>
</flowgorithm>
