<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
<attributes><attribute name="name" value="Propuesto 1.33"/><attribute name="authors" value="Javier Marcelo Flores Monrroy"/></attributes>
<function name="Main" type="None" variable=""><parameters/><body><declare name="B" type="Integer" array="False" size=""/><declare name="P" type="Integer" array="False" size=""/><declare name="R" type="Integer" array="False" size=""/><declare name="C" type="Integer" array="False" size=""/><declare name="S" type="Integer" array="False" size=""/><declare name="i" type="Integer" array="False" size=""/><output expression="&quot;Base&quot;" newline="True"/><input variable="B"/><output expression="&quot;Exponente&quot;" newline="True"/><input variable="P"/><assign variable="R" expression="1"/><for variable="C" start="1" end="P" direction="inc" step="1"><assign variable="S" expression="0"/><for variable="i" start="1" end="B" direction="inc" step="1"><assign variable="S" expression="S + R"/></for><assign variable="R" expression="S"/></for><output expression="R" newline="True"/></body></function>
</flowgorithm>
