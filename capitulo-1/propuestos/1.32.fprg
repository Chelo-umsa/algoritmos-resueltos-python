<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
<attributes><attribute name="name" value="Propuesto 1.32"/><attribute name="authors" value="Javier Marcelo Flores Monrroy"/></attributes>
<function name="Main" type="None" variable=""><parameters/><body><declare name="A" type="Integer" array="False" size=""/><declare name="B" type="Integer" array="False" size=""/><declare name="S" type="Integer" array="False" size=""/><declare name="Q" type="Integer" array="False" size=""/><declare name="R" type="Integer" array="False" size=""/><output expression="&quot;Dividendo&quot;" newline="True"/><input variable="A"/><output expression="&quot;Divisor&quot;" newline="True"/><input variable="B"/><assign variable="S" expression="0"/><assign variable="Q" expression="0"/><while expression="(S + B) &lt;= A"><assign variable="S" expression="S + B"/><assign variable="Q" expression="Q + 1"/></while><assign variable="R" expression="0"/><while expression="S &lt; A"><assign variable="S" expression="S + 1"/><assign variable="R" expression="R + 1"/></while><output expression="&quot;Cociente:&quot; &amp; &quot; &quot; &amp; Q" newline="True"/><output expression="&quot;Resto:&quot; &amp; &quot; &quot; &amp; R" newline="True"/></body></function>
</flowgorithm>
