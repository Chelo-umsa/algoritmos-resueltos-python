<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
<attributes><attribute name="name" value="Propuesto 1.26"/><attribute name="authors" value="Javier Marcelo Flores Monrroy"/></attributes>
<function name="Main" type="None" variable=""><parameters/><body><declare name="N" type="Integer" array="False" size=""/><declare name="C" type="Integer" array="False" size=""/><declare name="M" type="Integer" array="False" size=""/><declare name="Q1" type="Integer" array="False" size=""/><declare name="Q2" type="Integer" array="False" size=""/><declare name="i" type="Integer" array="False" size=""/><output expression="&quot;Cantidad de pares&quot;" newline="True"/><input variable="N"/><assign variable="C" expression="0"/><assign variable="M" expression="2"/><while expression="C &lt; N"><assign variable="M" expression="M + 1"/><assign variable="Q1" expression="0"/><assign variable="Q2" expression="0"/><for variable="i" start="1" end="M + 3 - 1" direction="inc" step="1"><if expression="(M % i) == 0"><then><assign variable="Q1" expression="Q1 + 1"/></then><else></else></if><if expression="((M + 2) % i) == 0"><then><assign variable="Q2" expression="Q2 + 1"/></then><else></else></if></for><if expression="Q1 == 2 and Q2 == 2"><then><output expression="&quot;(&quot; &amp; &quot; &quot; &amp; M &amp; &quot; &quot; &amp; &quot;,&quot; &amp; &quot; &quot; &amp; M + 2 &amp; &quot; &quot; &amp; &quot;)&quot;" newline="True"/><assign variable="C" expression="C + 1"/></then><else></else></if></while></body></function>
</flowgorithm>
