<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
<attributes><attribute name="name" value="Propuesto 1.39"/><attribute name="authors" value="Javier Marcelo Flores Monrroy"/></attributes>
<function name="Main" type="None" variable=""><parameters/><body><declare name="N" type="Integer" array="False" size=""/><declare name="Q" type="Integer" array="False" size=""/><declare name="hayImpar" type="Boolean" array="False" size=""/><declare name="hayPar" type="Boolean" array="False" size=""/><declare name="D" type="Integer" array="False" size=""/><output expression="&quot;Número de varios dígitos&quot;" newline="True"/><input variable="N"/><assign variable="Q" expression="0"/><assign variable="hayImpar" expression="false"/><assign variable="hayPar" expression="false"/><while expression="N &gt; 0"><assign variable="D" expression="N % 10"/><if expression="(D % 2) == 1"><then><if expression="hayImpar and hayPar"><then><assign variable="Q" expression="Q + 1"/></then><else></else></if><assign variable="hayImpar" expression="true"/><assign variable="hayPar" expression="false"/></then><else><assign variable="hayPar" expression="true"/></else></if><assign variable="N" expression="N / 10"/></while><output expression="Q" newline="True"/></body></function>
</flowgorithm>
