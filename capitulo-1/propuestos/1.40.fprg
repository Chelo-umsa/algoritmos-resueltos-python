<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
<attributes><attribute name="name" value="Propuesto 1.40"/><attribute name="authors" value="Javier Marcelo Flores Monrroy"/></attributes>
<function name="Main" type="None" variable=""><parameters/><body><declare name="N" type="Integer" array="False" size=""/><declare name="S" type="Real" array="False" size=""/><declare name="F" type="Integer" array="False" size=""/><declare name="C" type="Integer" array="False" size=""/><output expression="&quot;Cantidad de términos&quot;" newline="True"/><input variable="N"/><assign variable="S" expression="0"/><assign variable="F" expression="1"/><for variable="C" start="0" end="N - 1" direction="inc" step="1"><if expression="C &gt; 0"><then><assign variable="F" expression="F * C"/></then><else></else></if><assign variable="S" expression="S + ((-2 + (5 * C)) / F)"/></for><output expression="S" newline="True"/></body></function>
</flowgorithm>
