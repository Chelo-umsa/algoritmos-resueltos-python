<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
<attributes><attribute name="name" value="Propuesto 1.36"/><attribute name="authors" value="Javier Marcelo Flores Monrroy"/></attributes>
<function name="Main" type="None" variable=""><parameters/><body><declare name="N" type="Integer" array="False" size=""/><declare name="C" type="Integer" array="False" size=""/><declare name="M" type="Integer" array="False" size=""/><declare name="Q" type="Integer" array="False" size=""/><declare name="i" type="Integer" array="False" size=""/><declare name="K" type="Integer" array="False" size=""/><output expression="&quot;Cantidad de primos&quot;" newline="True"/><input variable="N"/><assign variable="C" expression="0"/><assign variable="M" expression="1"/><while expression="C &lt; N"><assign variable="M" expression="M + 1"/><assign variable="Q" expression="0"/><for variable="i" start="1" end="M" direction="inc" step="1"><if expression="(M % i) == 0"><then><assign variable="Q" expression="Q + 1"/></then><else></else></if></for><if expression="Q == 2"><then><assign variable="C" expression="C + 1"/></then><else></else></if></while><for variable="K" start="M" end="2" direction="dec" step="1"><assign variable="Q" expression="0"/><for variable="i" start="1" end="K" direction="inc" step="1"><if expression="(K % i) == 0"><then><assign variable="Q" expression="Q + 1"/></then><else></else></if></for><if expression="Q == 2"><then><output expression="K" newline="True"/></then><else></else></if></for></body></function>
</flowgorithm>
