<?xml version='1.0' encoding='utf-8'?>
<flowgorithm fileversion="4.2"><attributes /><function name="Main" type="None" variable=""><parameters /><body><declare name="N" type="Integer" array="False" size="" /><declare name="C" type="Integer" array="False" size="" /><declare name="S" type="Integer" array="False" size="" /><output expression="&quot;Ingrese un numero natural&quot;" newline="True" /><input variable="N" /><assign variable="S" expression="0" /><for variable="C" start="1" end="N - 1" direction="inc" step="1"><if expression="N % C = 0"><then><assign variable="S" expression="S + C" /></then><else /></if></for><if expression="S = N"><then><output expression="&quot;Es un numero perfecto&quot;" newline="True" /></then><else><output expression="&quot;No es un numero perfecto&quot;" newline="True" /></else></if></body></function></flowgorithm>