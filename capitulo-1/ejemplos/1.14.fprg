<flowgorithm fileversion="4.2"><attributes /><function name="Main" type="None" variable=""><parameters /><body><declare name="B" type="Integer" array="False" size="" /><declare name="B" type="Integer" array="False" size="" /><declare name="D" type="Integer" array="False" size="" /><declare name="P" type="Integer" array="False" size="" /><declare name="S" type="Integer" array="False" size="" /><output expression="&quot;Ingrese un numero binario&quot;" newline="True" /><input variable="B" /><assign variable="S" expression="0" /><assign variable="P" expression="1" /><while expression="B &gt; 0"><assign variable="D" expression="B % 10" /><assign variable="S" expression="S + D * P" /><assign variable="P" expression="P * 2" /><assign variable="B" expression="B / 10" /></while><output expression="&quot;El equivalente decimal es &quot; &amp; S" newline="True" /></body></function></flowgorithm>