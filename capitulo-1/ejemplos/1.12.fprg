<flowgorithm fileversion="4.2"><attributes /><function name="Main" type="None" variable=""><parameters /><body><declare name="N" type="Integer" array="False" size="" /><declare name="N" type="Integer" array="False" size="" /><declare name="D" type="Integer" array="False" size="" /><declare name="R" type="Integer" array="False" size="" /><output expression="&quot;Ingrese un numero de varios digitos&quot;" newline="True" /><input variable="N" /><assign variable="R" expression="0" /><while expression="N &gt; 0"><assign variable="D" expression="N % 10" /><assign variable="R" expression="R * 10 + D" /><assign variable="N" expression="N / 10" /></while><output expression="&quot;El numero invertido es &quot; &amp; R" newline="True" /></body></function></flowgorithm>