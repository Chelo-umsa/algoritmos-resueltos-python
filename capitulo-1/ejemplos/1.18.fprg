<?xml version='1.0' encoding='utf-8'?>
<flowgorithm fileversion="4.2"><attributes /><function name="Main" type="None" variable=""><parameters /><body><declare name="N" type="Integer" array="False" size="" /><declare name="C" type="Integer" array="False" size="" /><declare name="Q" type="Integer" array="False" size="" /><output expression="&quot;Ingrese un numero natural mayor que 1&quot;" newline="True" /><input variable="N" /><assign variable="Q" expression="0" /><for variable="C" start="1" end="N" direction="inc" step="1"><if expression="N % C = 0"><then><assign variable="Q" expression="Q + 1" /></then><else /></if></for><if expression="Q = 2"><then><output expression="&quot;Es un numero primo&quot;" newline="True" /></then><else><output expression="&quot;No es un numero primo&quot;" newline="True" /></else></if></body></function></flowgorithm>