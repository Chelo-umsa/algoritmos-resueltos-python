<flowgorithm fileversion="4.2"><attributes /><function name="Main" type="None" variable=""><parameters /><body><declare name="B" type="Integer" array="False" size="" /><declare name="E" type="Integer" array="False" size="" /><declare name="P" type="Integer" array="False" size="" /><declare name="C" type="Integer" array="False" size="" /><output expression="&quot;Ingrese la base&quot;" newline="True" /><input variable="B" /><output expression="&quot;Ingrese el exponente&quot;" newline="True" /><input variable="E" /><assign variable="P" expression="1" /><for variable="C" start="1" end="E" direction="inc" step="1"><assign variable="P" expression="P * B" /></for><output expression="&quot;La potencia es &quot; &amp; P" newline="True" /></body></function></flowgorithm>