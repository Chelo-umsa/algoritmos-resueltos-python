<?xml version='1.0' encoding='utf-8'?>
<flowgorithm fileversion="4.2"><attributes /><function name="Main" type="None" variable=""><parameters /><body><declare name="N" type="Integer" array="False" size="" /><declare name="N" type="Integer" array="False" size="" /><declare name="D" type="Integer" array="False" size="" /><declare name="B" type="Integer" array="False" size="" /><declare name="P" type="Integer" array="False" size="" /><output expression="&quot;Ingrese un numero decimal&quot;" newline="True" /><input variable="N" /><assign variable="B" expression="0" /><assign variable="P" expression="1" /><while expression="N &gt; 0"><assign variable="D" expression="N % 2" /><assign variable="B" expression="B + D * P" /><assign variable="P" expression="P * 10" /><assign variable="N" expression="N / 2" /></while><output expression="&quot;El equivalente binario es &quot; &amp; B" newline="True" /></body></function></flowgorithm>