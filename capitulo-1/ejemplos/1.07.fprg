<flowgorithm fileversion="4.2"><attributes /><function name="Main" type="None" variable=""><parameters /><body><declare name="M" type="Integer" array="False" size="" /><declare name="N" type="Integer" array="False" size="" /><declare name="P" type="Integer" array="False" size="" /><declare name="C" type="Integer" array="False" size="" /><output expression="&quot;Ingrese el multiplicando&quot;" newline="True" /><input variable="M" /><output expression="&quot;Ingrese el multiplicador&quot;" newline="True" /><input variable="N" /><assign variable="P" expression="0" /><for variable="C" start="1" end="N" direction="inc" step="1"><assign variable="P" expression="P + M" /></for><output expression="&quot;El producto es &quot; &amp; P" newline="True" /></body></function></flowgorithm>