<?xml version='1.0' encoding='utf-8'?>
<flowgorithm fileversion="4.2"><attributes /><function name="Main" type="None" variable=""><parameters /><body><declare name="N1" type="Real" array="False" size="" /><declare name="N2" type="Real" array="False" size="" /><declare name="N3" type="Real" array="False" size="" /><declare name="N4" type="Real" array="False" size="" /><declare name="S" type="Real" array="False" size="" /><declare name="P" type="Real" array="False" size="" /><output expression="&quot;Nota del primer parcial&quot;" newline="True" /><input variable="N1" /><output expression="&quot;Nota del segundo parcial&quot;" newline="True" /><input variable="N2" /><output expression="&quot;Nota del tercer parcial&quot;" newline="True" /><input variable="N3" /><output expression="&quot;Nota del examen final&quot;" newline="True" /><input variable="N4" /><assign variable="S" expression="N1 + N2 + N3 + N4" /><assign variable="P" expression="S / 4" /><output expression="&quot;El promedio del estudiante es &quot; &amp; P" newline="True" /></body></function></flowgorithm>