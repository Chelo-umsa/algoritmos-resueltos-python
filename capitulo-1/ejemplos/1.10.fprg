<?xml version='1.0' encoding='utf-8'?>
<flowgorithm fileversion="4.2"><attributes /><function name="Main" type="None" variable=""><parameters /><body><declare name="N" type="Integer" array="False" size="" /><declare name="S" type="Integer" array="False" size="" /><declare name="P" type="Integer" array="False" size="" /><declare name="Q" type="Integer" array="False" size="" /><assign variable="S" expression="0" /><assign variable="P" expression="1" /><assign variable="Q" expression="0" /><output expression="&quot;Ingrese un numero&quot;" newline="True" /><input variable="N" /><while expression="N % 2 = 1"><if expression="N &lt; 50"><then><assign variable="S" expression="S + N" /></then><else><if expression="N &gt; 100"><then><assign variable="P" expression="P * N" /></then><else><assign variable="Q" expression="Q + 1" /></else></if></else></if><output expression="&quot;Ingrese un numero&quot;" newline="True" /><input variable="N" /></while><output expression="&quot;Suma de los menores a 50: &quot; &amp; S" newline="True" /><output expression="&quot;Producto de los mayores a 100: &quot; &amp; P" newline="True" /><output expression="&quot;Cantidad de los demas: &quot; &amp; Q" newline="True" /></body></function></flowgorithm>