<flowgorithm fileversion="4.2"><attributes /><function name="Main" type="None" variable=""><parameters /><body><declare name="N" type="Integer" array="False" size="" /><declare name="N" type="Integer" array="False" size="" /><declare name="D" type="Integer" array="False" size="" /><output expression="&quot;Ingrese un numero de varios digitos&quot;" newline="True" /><input variable="N" /><while expression="N &gt; 0"><assign variable="D" expression="N % 10" /><output expression="D" newline="True" /><assign variable="N" expression="N / 10" /></while></body></function></flowgorithm>