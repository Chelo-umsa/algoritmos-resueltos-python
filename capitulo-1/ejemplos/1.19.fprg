<?xml version='1.0' encoding='utf-8'?>
<flowgorithm fileversion="4.2"><attributes /><function name="Main" type="None" variable=""><parameters /><body><declare name="N" type="Integer" array="False" size="" /><declare name="T" type="Integer" array="False" size="" /><declare name="D" type="Integer" array="False" size="" /><declare name="F" type="Integer" array="False" size="" /><declare name="S" type="Integer" array="False" size="" /><declare name="C" type="Integer" array="False" size="" /><output expression="&quot;Ingrese un numero natural&quot;" newline="True" /><input variable="N" /><assign variable="T" expression="N" /><assign variable="S" expression="0" /><while expression="T &gt; 0"><assign variable="D" expression="T % 10" /><assign variable="F" expression="1" /><for variable="i" start="1" end="D" direction="inc" step="1"><assign variable="F" expression="F * i" /></for><assign variable="S" expression="S + F" /><assign variable="T" expression="T / 10" /></while><if expression="S = N"><then><output expression="&quot;Es un numero fuerte&quot;" newline="True" /></then><else><output expression="&quot;No es un numero fuerte&quot;" newline="True" /></else></if></body></function></flowgorithm>