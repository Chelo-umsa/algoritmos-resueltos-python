<flowgorithm fileversion="4.2"><attributes /><function name="Main" type="None" variable=""><parameters /><body><declare name="N" type="Integer" array="False" size="" /><declare name="A" type="Integer" array="False" size="" /><declare name="B" type="Integer" array="False" size="" /><declare name="S" type="Integer" array="False" size="" /><declare name="C" type="Integer" array="False" size="" /><output expression="&quot;Ingrese la cantidad de terminos&quot;" newline="True" /><input variable="N" /><assign variable="A" expression="0" /><assign variable="B" expression="1" /><for variable="C" start="1" end="N" direction="inc" step="1"><output expression="A" newline="True" /><assign variable="S" expression="A + B" /><assign variable="A" expression="B" /><assign variable="B" expression="S" /></for></body></function></flowgorithm>