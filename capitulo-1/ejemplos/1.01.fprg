    <function name="Main" type="None" variable="">
        <parameters />
        <body>
            <declare name="Altura, Base" type="Integer" array="False" size="" /><declare name="Area" type="Real" array="False" size="" />
            <output expression="&quot;Altura del triángulo&quot;" newline="True" />
            <input variable="Altura" />
            <output expression="&quot;Base del triángulo&quot;" newline="True" />
            <input variable="Base" />
            <assign variable="Area" expression="Altura*Base/2" />
            <output expression="&quot;El area es &quot; &amp;Area&amp; &quot; m^2&quot;" newline="True" />
        </body>
    </function>
