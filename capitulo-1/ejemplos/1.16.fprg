<?xml version='1.0' encoding='utf-8'?>
<flowgorithm fileversion="4.2"><attributes /><function name="Main" type="None" variable=""><parameters /><body><declare name="N" type="Integer" array="False" size="" /><declare name="T" type="Integer" array="False" size="" /><declare name="D" type="Integer" array="False" size="" /><declare name="M" type="Integer" array="False" size="" /><declare name="C" type="Integer" array="False" size="" /><output expression="&quot;Ingrese un numero de varios digitos&quot;" newline="True" /><input variable="N" /><assign variable="M" expression="0" /><for variable="C" start="0" end="9" direction="inc" step="1"><assign variable="T" expression="N" /><while expression="T &gt; 0"><assign variable="D" expression="T % 10" /><if expression="D = C"><then><assign variable="M" expression="M * 10 + D" /></then><else /></if><assign variable="T" expression="T / 10" /></while></for><output expression="&quot;El nuevo numero es &quot; &amp; M" newline="True" /></body></function></flowgorithm>