<flowgorithm fileversion="4.2"><attributes /><function name="Main" type="None" variable=""><parameters /><body><declare name="N" type="Integer" array="False" size="" /><declare name="N" type="Integer" array="False" size="" /><declare name="D" type="Integer" array="False" size="" /><output expression="&quot;Ingrese un numero natural&quot;" newline="True" /><input variable="N" /><assign variable="D" expression="2" /><while expression="N &gt; 1"><if expression="N % D = 0"><then><output expression="D" newline="True" /><assign variable="N" expression="N / D" /></then><else><assign variable="D" expression="D + 1" /></else></if></while></body></function></flowgorithm>