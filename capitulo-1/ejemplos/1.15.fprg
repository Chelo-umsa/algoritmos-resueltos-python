<?xml version='1.0' encoding='utf-8'?>
<flowgorithm fileversion="4.2"><attributes /><function name="Main" type="None" variable=""><parameters /><body><declare name="N" type="Integer" array="False" size="" /><declare name="T" type="Integer" array="False" size="" /><declare name="D" type="Integer" array="False" size="" /><declare name="R" type="Integer" array="False" size="" /><output expression="&quot;Ingrese un numero de varios digitos&quot;" newline="True" /><input variable="N" /><assign variable="T" expression="N" /><assign variable="R" expression="0" /><while expression="T &gt; 0"><assign variable="D" expression="T % 10" /><assign variable="R" expression="R * 10 + D" /><assign variable="T" expression="T / 10" /></while><if expression="N = R"><then><output expression="&quot;Es capicua&quot;" newline="True" /></then><else><output expression="&quot;No es capicua&quot;" newline="True" /></else></if></body></function></flowgorithm>