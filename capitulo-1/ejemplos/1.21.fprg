<flowgorithm fileversion="4.2"><attributes /><function name="Main" type="None" variable=""><parameters /><body><declare name="N" type="Integer" array="False" size="" /><declare name="C" type="Integer" array="False" size="" /><declare name="M" type="Integer" array="False" size="" /><declare name="Q" type="Integer" array="False" size="" /><declare name="K" type="Integer" array="False" size="" /><output expression="&quot;Ingrese la cantidad de primos que desea&quot;" newline="True" /><input variable="N" /><assign variable="C" expression="0" /><assign variable="M" expression="1" /><while expression="C &lt; N"><assign variable="M" expression="M + 1" /><assign variable="Q" expression="0" /><for variable="i" start="1" end="M" direction="inc" step="1"><if expression="M % i = 0"><then><assign variable="Q" expression="Q + 1" /></then><else /></if></for><if expression="Q = 2"><then><output expression="M" newline="True" /><assign variable="C" expression="C + 1" /></then><else /></if></while></body></function></flowgorithm>